{
  "name": "tbradar",
  "private": true,
  "version": "0.1.0",
  "description": "Find books from your reading list in a shelf photo, locally in your browser.",
  "license": "MIT",
  "author": "KanadeK",
  "homepage": "https://kanadek.github.io/tbradar/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KanadeK/tbradar.git"
  },
  "bugs": {
    "url": "https://github.com/KanadeK/tbradar/issues"
  },
  "keywords": [
    "books",
    "goodreads",
    "storygraph",
    "ocr",
    "reading-list",
    "tesseract",
    "privacy"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "check:static": "node scripts/check-static.mjs && node scripts/verify-ocr-assets.mjs",
    "sync:ocr": "node scripts/sync-ocr-assets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep-invert @ocr",
    "test:e2e:ocr": "playwright test --grep @ocr",
    "docs:screenshot": "node scripts/capture-screenshot.mjs",
    "verify": "npm run check:static && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e",
    "verify:full": "npm run verify && npm run test:e2e:ocr && npm audit --audit-level=high --registry=https://registry.npmjs.org/",
    "package": "node scripts/package-release.mjs",
    "package:verify": "node scripts/check-determinism.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "papaparse": "5.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fflate": "0.8.2",
    "globals": "16.5.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
